<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the 4B model fit. Enable "Increased Memory Limit" on the App ID in the
	     Apple Developer portal too. Test a TestFlight build early: one developer
	     reported it worked locally but not in their App Store build. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
